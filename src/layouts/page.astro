---
const { frontmatter } = Astro.props;
import Navbar from "../components/navbar.astro";
import "../global.css";
import nutshellUrl from "../assets/nutshell.js?url";
import { ORGANIZATION_SCHEMA, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "../lib/site";

const title = frontmatter?.title ?? SITE_NAME;
const description = frontmatter?.description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), SITE_URL).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ORGANIZATION_SCHEMA,
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: `${SITE_NAME} // Hack Club`,
      alternateName: SITE_NAME,
      description: SITE_DESCRIPTION,
      url: `${SITE_URL}/`,
      inLanguage: "en",
      publisher: { "@id": ORGANIZATION_SCHEMA["@id"] },
      about: { "@id": ORGANIZATION_SCHEMA["@id"] },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: "en",
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": ORGANIZATION_SCHEMA["@id"] },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <script
      defer
      src="https://umami.eofr.dev/script.js"
      data-website-id="68e539ce-a587-4b3d-834a-097a0886158f"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>README // {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={canonical} title={`${title} (Markdown)`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE_NAME} // Hack Club`} />
    <meta property="og:title" content={`README // ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a href="https://hackclub.com/"
      ><img
        style="position: fixed; top: 0; left: 10px; border: 0; width: clamp(1.5rem, 30vw, 170px); z-index: 999;"
        src="https://assets.hackclub.com/flag-orpheus-top.svg"
        alt="Hack Club"
      /></a
    >
    <Navbar />
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<!-- Custom nutshell.js with the 'remove css classes' thing applied. Cus I need codeblocks from Prism -->
<script is:inline src={nutshellUrl}></script>
